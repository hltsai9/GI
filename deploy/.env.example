# Copy to deploy/.env, fill in, and keep it private (chmod 600). Never commit .env.

# ---- Which containers to run --------------------------------------------------------
# "db" = also run a MariaDB container. Remove it to use an existing MariaDB server
# (then set MARIADB_URL below).
COMPOSE_PROFILES=db

# ---- Images ---------------------------------------------------------------------------
# Image name and tag: IMAGE_PREFIX:GI_VERSION. With a company registry, set IMAGE_PREFIX to e.g.
# registry.example.local/cleanroom/gi
IMAGE_PREFIX=gi
GI_VERSION=latest

# ---- Building the images (only if your network needs it) -----------------------------
# Company proxy for downloading packages during the build:
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
# "host" if the proxy runs on the build machine itself (address 127.0.0.1 / localhost):
BUILD_NETWORK=
# Internal PyPI mirror (e.g. Nexus/Artifactory, ending in /simple); empty = public PyPI:
PIP_INDEX_URL=
# Company root certificate (PEM) if the proxy inspects HTTPS; empty = none:
COMPANY_CA_FILE=
# Base images, e.g. the company's Python image or a mirror of Docker Hub (defaults shown; Python 3.10+):
# PYTHON_IMAGE=python:3.12-slim
# MARIADB_IMAGE=mariadb:11.4

# ---- Web --------------------------------------------------------------------------------
# Port on the host for the web page (http://<host>:HTTP_PORT)
HTTP_PORT=8080

# ---- Database ---------------------------------------------------------------------------
# Passwords for the MariaDB container (letters and digits only, or URL-encode them in MARIADB_URL).
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Only for an existing MariaDB server (otherwise leave empty). Either separate settings…
MARIADB_HOST=
MARIADB_USER=gi
MARIADB_PASSWORD=
MARIADB_DATABASE=gi
# …or one URL (special characters in the password must be URL-encoded):
# MARIADB_URL=mysql://gi:password@db-host.example.local:3306/gi
MARIADB_URL=

# ---- Issue data -------------------------------------------------------------------------
# "mock" = generated test data inside the container (no Oracle connection needed);
# "oracle" = the real issuing system; "csv" = no automatic import, upload Oracle exports in Settings › Import (SOP §8.4).
ISSUE_SOURCE=mock
ORACLE_CONNECT_STRING=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_ISSUE_TABLE=
ORACLE_SUIT_TABLE=
# First INSERT_TIME to read on a fresh install (Phoenix local time). Empty = 2026-10-01 00:00:00.
ORACLE_BACKFILL_FROM=
ORACLE_POLL_SECONDS=300

# ---- Sign-in ----------------------------------------------------------------------------
# Company SSO is not connected yet. true = choose the user in Settings › This device.
# Test environments only: anyone who can open the page can act as any user.
DEV_AUTH=true
# Passcode for switching to the Admin user in Settings › This device (secret). Empty = Admin is locked.
ADMIN_PASSCODE=

# ---- Time zones (defaults are correct for Fab1/Fab2) -----------------------------------
SITE_TIMEZONE=America/Phoenix
# INSERT_TIME (the scan time) is Phoenix local time. RECTIME is not used.
ORACLE_INSERT_TIME_ZONE=America/Phoenix
