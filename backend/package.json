{
  "name": "gi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "mock:generate": "tsx mock-oracle/generate.ts",
    "import:once": "tsx src/cli/importOnce.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "tsx src/cli/resetDev.ts",
    "demo": "tsx src/cli/demo.ts",
    "export:demo": "tsx src/cli/exportDemo.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/src/server.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "oracledb": "^6.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/oracledb": "^6.10.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
