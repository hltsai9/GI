# Copy to .env and fill in. Never commit .env.

# GI database (MariaDB)
MARIADB_URL=mysql://gi:gi@localhost:3306/gi

# Where issue data comes from: "mock" or "oracle". Mock data is generated in memory, or read from
# MOCK_ORACLE_DIR/issues.ndjson if that file exists (write one with: python -m gi.mock_oracle)
ISSUE_SOURCE=mock
MOCK_ORACLE_DIR=./mock-oracle-data

# Oracle (only when ISSUE_SOURCE=oracle)
ORACLE_CONNECT_STRING=host:1521/service
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_ISSUE_TABLE=SCHEMA.ISSUE_TABLE
ORACLE_SUIT_TABLE=

# Import
ORACLE_POLL_SECONDS=300
ORACLE_OVERLAP_MINUTES=10
ORACLE_MAX_ROWS=5000
ORACLE_SWEEP_DAYS=3
ORACLE_TIME_TOLERANCE_MINUTES=10
# First RECTIME to read on a fresh install (Phoenix local time), for the history backfill
ORACLE_BACKFILL_FROM=2026-10-01 00:00:00

# Time zones
SITE_TIMEZONE=America/Phoenix
ORACLE_INSERT_TIME_ZONE=Asia/Taipei
ORACLE_RECTIME_ZONE=America/Phoenix

# Web
PORT=3000
# Dev only: allow choosing the user with the X-Dev-User header instead of SSO
DEV_AUTH=true
